# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare 本地密钥
.dev.vars

# Cloudflare 构建产物（含内联的环境变量，绝不能进库）
.open-next/
.wrangler/

# Claude Code 个人配置（含生产库写权限，不要提交）
.claude/settings.local.json

# GSC 原始快照：可由 npm run gsc 重新生成，行数多，不进版本库
docs/seo/data/*.json

# 第三方外链提交技能仓库（backlink_skills）：只作本地工具使用，不进版本库
/tools/backlink_skills/
/tools/*.zip

# 外链战役抓取证据（HTML/截图/响应，可由 scripts/backlink-*.mjs 重新生成）
docs/seo/backlink-campaign/evidence/
